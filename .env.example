NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hiking_store
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_SAME_SITE=lax
CORS_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:5173
# Optional OAuth providers:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
# FB_APP_ID=
# FB_APP_SECRET=
# FB_CALLBACK_URL=http://localhost:5173/api/auth/facebook/callback
# Optional, isolated integration test database:
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hiking_store_test

# Enable explicit order status simulation for the portfolio demo:
DEMO_MODE=true
